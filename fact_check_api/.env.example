# Fact-Check API Configuration

# LLM Configuration (for entity extraction)
LLM_PROVIDER=openai/gpt-4o-mini
LLM_API_TOKEN=your_openai_api_key_here

# Or use other providers:
# LLM_PROVIDER=anthropic/claude-3-haiku
# LLM_API_TOKEN=your_anthropic_key

# LLM_PROVIDER=ollama/llama3.3
# LLM_API_TOKEN=no-token

# Search Configuration
# Optional: Use SerpAPI for better search results (requires paid subscription)
# SERPAPI_KEY=your_serpapi_key_here

# Crawler Configuration
MAX_CONCURRENT_CRAWLS=5
CRAWL_TIMEOUT=15

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_LEVEL=INFO
